# ==============================================================================
# COMMENTARY / BRAINROT MODE - REFERENCE CONFIGURATION (.env)
# ==============================================================================
# Use this configuration when CURATOR_MODE=False to generate AI commentary
# shorts with gameplay backgrounds, dark mode Reddit cards, voiceover, and captions.

DATA_DIR_NAME=data

# ── INGESTION ─────────────────────────────────────────────────────────────────
SUBREDDITS=memes, dankmemes, me_irl, AskReddit, Showerthoughts
REDDIT_SORT=hot
REDDIT_TIME_FILTER=day
REDDIT_MIN_SCORE=200
REDDIT_MIN_COMMENTS=20
ONLY_VIDEOS=False
ONLY_REDDIT_HOSTED=False

# Optional: Reddit API credentials (anonymous feeds used if empty)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=RedditShortsBot/1.0

# ── OPERATIONAL MODE ─────────────────────────────────────────────────────────
CURATOR_MODE=False
NARRATION_MODE=commentary

# ── LLM SCRIPT GENERATION ─────────────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL="qwen/qwen3.8-27b"

# ── TEXT-TO-SPEECH (TTS) ──────────────────────────────────────────────────────
TTS_PROVIDER=edge
TTS_VOICE=en-US-AndrewNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── GAMEPLAY BACKGROUND FOOTAGE ───────────────────────────────────────────────
BACKGROUND_PROVIDERS=minecraft parkour gameplay 1080p, subway surfers gameplay 1080p, satisfying videos 1080p
LOCAL_BACKGROUNDS_DIR=data/raw
YTDL_MAX_DOWNLOADS=2
YTDL_FORMAT="bestvideo[height<=1080][ext=mp4]+bestaudio[ext=m4a]/best[height<=1080]"

# ── CAPTIONS & SUBTITLES ──────────────────────────────────────────────────────
CAPTION_STYLE=chaotic          # chaotic, meme, story, npc
CAPTION_FONT=Impact
RENDER_FPS=60
OVERLAY_REDDIT_SCREENSHOT=True
OVERLAY_PROFILE_ICON=True
OVERLAY_SUBREDDIT_TAG=True
OVERLAY_PROGRESS_BAR=False
OVERLAY_BACKGROUND_BLUR=True

# ── CAT REACTIONS & GREENSCREEN ──────────────────────────────────────────────
CAT_REACTION_FOLDER=data/assets/cat_reactions
CAT_LAYOUT_HEIGHT=0.25
MEME_LAYOUT_HEIGHT=0.75
ENABLE_CAT_REACTIONS=True
CAT_SELECTION_MODE=random
CAT_AVOID_REPEAT=True

GREENSCREEN_FILE=data/assets/cat_reactions/Long green screen video.mp4
USE_GREENSCREEN=True
GREENSCREEN_PROBABILITY=0.40
GREENSCREEN_SEGMENT_MIN=4.5
GREENSCREEN_SEGMENT_MAX=4.5
GREENSCREEN_CHROMA_COLOR="0x00B140"
GREENSCREEN_CHROMA_SIMILARITY=0.12
GREENSCREEN_CHROMA_BLEND=0.08
GREENSCREEN_MAX_WIDTH=800
GREENSCREEN_MAX_HEIGHT=800

# ── SAFETY & POLICY ───────────────────────────────────────────────────────────
ENABLE_CONTENT_SAFETY=True
SAFETY_MODE=standard
MAX_ALLOWED_RISK=low
REJECT_FEMALE_HUMANS=False
REJECT_WATERMARKS=False
ENABLE_MEME_SUITABILITY=False
GEMINI_API_KEY=

# ── YOUTUBE PUBLISHING ────────────────────────────────────────────────────────
YT_CLIENT_ID=
YT_CLIENT_SECRET_VALUE=
YT_REFRESH_TOKEN=
YOUTUBE_PRIVACY=public

# ── METADATA & SCHEDULE ───────────────────────────────────────────────────────
METADATA_MENTIONS=
METADATA_TRENDING_TAGS=reddit, redditstories, memes, gameplay, minecraft, subwaysurfers, shorts
METADATA_DISCLAIMER=Original content from Reddit. Voiceover and captions created for entertainment.
MAX_VIDEOS_PER_DAY=3
UPLOAD_SCHEDULE_TIMES=09:00, 15:00, 21:00

